{
  "name": "msnodesqlv8-react",
  "version": "1.1.3",
  "description": "React demo with msnodesqlv8",
  "main": "electron-main.js",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "electron": "electron .",
    "electron-dev": "node start-electron-dev.js",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron-rebuild": "electron-rebuild -w msnodesqlv8"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "msnodesqlv8": "^5.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@electron/rebuild": "^4.2.0",
    "babel-loader": "^10.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "html-webpack-plugin": "^5.6.8",
    "node-loader": "^2.1.0",
    "wait-on": "^9.1.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-node-externals": "^3.0.0"
  }
}
